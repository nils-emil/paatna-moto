---
import Layout from '../../../layouts/Layout.astro';
import BikeDetail from '../../../components/BikeDetail.astro';
import { riders } from '../../../data/riders';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  return riders.map((rider) => ({
    params: { slug: rider.bike.slug },
    props: { rider },
  }));
}

const { rider } = Astro.props;
const { bike } = rider;
const lang = 'en';
const s = t(lang);
const title = `${bike.make} ${bike.model} · ${s.siteTitle}`;
const description = s.bikePage.description(bike.make, bike.model, rider.name);
const altHref = `/masinad/${bike.slug}/`;
---

<Layout title={title} description={description} lang={lang}>
  <BikeDetail rider={rider} lang={lang} altHref={altHref} />
</Layout>
