---
import { riders, pick } from '../data/riders';
import { t, localizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<section id="masinad" class="bikes">
  <div class="container">
    <h2 class="section-title">{s.bikes.title}</h2>

    <table>
      <thead>
        <tr>
          <th>{s.bikes.thRider}</th>
          <th>{s.bikes.thBike}</th>
          <th>{s.bikes.thType}</th>
          <th>{s.bikes.thEngine}</th>
          <th aria-label={s.bikes.thOpen}></th>
        </tr>
      </thead>
      <tbody>
        {riders.map((rider) => {
          const href = localizedPath(lang, `/masinad/${rider.bike.slug}/`);
          return (
            <tr onclick={`window.location='${href}'`}>
              <td>{rider.name}</td>
              <td>
                <a href={href}>
                  {rider.bike.make} {rider.bike.model}
                </a>
              </td>
              <td>{pick(rider.bike.type, lang) ?? ''}</td>
              <td>{pick(rider.bike.engine, lang) ?? ''}</td>
              <td class="arrow">→</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<style>
  .bikes {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .section-title {
    text-transform: none;
    font-weight: 700;
    letter-spacing: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: 2.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--border);
  }

  th, td {
    text-align: left;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }

  th {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--bg-elev);
  }

  tbody tr {
    cursor: pointer;
    transition: background 0.15s ease;
  }

  tbody tr:hover {
    background: var(--bg-elev);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  td {
    color: var(--fg);
  }

  td:nth-child(3), td:nth-child(4) {
    color: var(--muted);
  }

  td a {
    color: var(--fg);
    border-bottom: 1px solid transparent;
  }

  tbody tr:hover td a {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .arrow {
    color: var(--accent);
    text-align: right;
    width: 2rem;
    transition: transform 0.15s ease;
  }

  tbody tr:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    table, thead, tbody, tr, th, td {
      display: block;
      width: 100%;
    }

    thead {
      position: absolute;
      left: -9999px;
    }

    table {
      border: none;
    }

    tbody tr {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 0.75rem;
      align-items: center;
      padding: 1rem 1rem;
      border: 1px solid var(--border);
      border-bottom: none;
    }

    tbody tr:last-child {
      border-bottom: 1px solid var(--border);
    }

    tbody tr td {
      padding: 0;
      border: none;
      font-size: 0.9rem;
      line-height: 1.35;
    }

    td:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    td:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
      font-size: 1.05rem;
      font-weight: 600;
    }

    td:nth-child(3),
    td:nth-child(4) {
      grid-column: 1;
      font-size: 0.8rem;
      color: var(--muted);
    }

    td:nth-child(3) {
      grid-row: 3;
    }

    td:nth-child(4) {
      grid-row: 4;
    }

    td.arrow {
      grid-column: 2;
      grid-row: 1 / span 4;
      width: auto;
      align-self: center;
      text-align: right;
      font-size: 1.25rem;
    }
  }
</style>
