---
import { t, type Lang } from '../i18n/ui';
import LangToggle from './LangToggle.astro';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const s = t(lang);
---

<header class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <nav class="nav container">
    <span class="brand">PAATNA<span>MK</span></span>
    <ul>
      <li><a href="#klubi">{s.nav.club}</a></li>
      <li><a href="#reis">{s.nav.trips}</a></li>
      <li><a href="#ratturid">{s.nav.riders}</a></li>
      <li><a href="#masinad">{s.nav.bikes}</a></li>
    </ul>
    <LangToggle lang={lang} altHref={altHref} />
  </nav>

  <div class="hero-inner container">
    <h1>
      Paatna<br />
      <span>{lang === 'et' ? 'Motoklubi' : 'Motorcycle Club'}</span>
    </h1>
    <div class="cta">
      <a href="#ratturid" class="btn btn-primary">{s.hero.ctaPrimary}</a>
      <a href="#klubi" class="btn btn-ghost">{s.hero.ctaGhost}</a>
    </div>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <span>{s.hero.scroll}</span>
    <div class="line"></div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(255, 77, 0, 0.18), transparent 60%),
      radial-gradient(ellipse at 80% 70%, rgba(255, 77, 0, 0.08), transparent 50%),
      linear-gradient(180deg, #0a0a0a 0%, #0a0a0a 60%, #050505 100%);
    z-index: -2;
  }

  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    gap: 1.5rem;
  }

  .brand {
    font-family: 'Oswald', sans-serif;
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: 0.15em;
    color: var(--fg);
  }

  .brand span {
    color: var(--accent);
    margin-left: 0.25rem;
  }

  .nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin-left: auto;
    margin-right: 1.5rem;
  }

  .nav ul a {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .nav ul a:hover {
    color: var(--fg);
  }

  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  h1 {
    font-size: clamp(3.5rem, 12vw, 9rem);
    line-height: 0.9;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
  }

  h1 span {
    color: var(--accent);
    -webkit-text-stroke: 2px var(--accent);
    color: transparent;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: #0a0a0a;
    border-color: var(--accent);
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--accent);
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--fg);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .scroll-indicator .line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, var(--accent), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.4); opacity: 0.4; }
  }

  @media (max-width: 640px) {
    .nav ul {
      display: none;
    }
    .nav ul {
      margin-right: 0;
    }
  }
</style>
