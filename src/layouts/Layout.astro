---
import '../styles/global.css';
import { t, otherLangPath, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  imageAlt?: string;
}

const { lang = 'et', title, description, image, imageAlt } = Astro.props;
const strings = t(lang);
const finalTitle = title ?? strings.siteTitle;
const finalDescription = description ?? strings.siteDescription;

const siteUrl = Astro.site ?? new URL('https://paatnamoto.ee');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const altPath = otherLangPath(lang, Astro.url.pathname);
const altUrl = new URL(altPath, siteUrl).toString();
const altLang: Lang = lang === 'et' ? 'en' : 'et';

const defaultImage = '/og-default.png';
const ogImageUrl = new URL(image ?? defaultImage, siteUrl).toString();
const ogImageAlt = imageAlt ?? finalTitle;

const ogLocale = lang === 'et' ? 'et_EE' : 'en_US';
const ogLocaleAlt = lang === 'et' ? 'en_US' : 'et_EE';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Paatna Motoklubi',
  alternateName: 'Paatna Motorcycle Club',
  url: siteUrl.toString(),
  logo: new URL('/favicon.svg', siteUrl).toString(),
  foundingDate: '2025',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'EE',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Paatna Motoklubi" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700;900&family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <style is:global>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      }
      h1, h2, h3 {
        font-family: 'Oswald', 'Impact', sans-serif;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
